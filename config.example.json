{
  "github_token": "ghp_your_github_token_here",
  "github_repos": [
    {
      "repo": "owner/repo1",
      "branch": "main"
    },
    {
      "repo": "owner/repo2",
      "branches": ["main", "dev"]
    },
    {
      "repo": "owner/repo3",
      "branch": "*"
    },
    "owner/repo4"
  ],
  "release_monitors": {
    "owner/repo1": {
      "asset_files": ["app-release-.*\\.apk", "checksums\\.txt"],
      "include_prerelease": false,
      "group_file_folder_name": "Release"
    },
    "owner/repo2": {
      "asset_files": ["plugin-v[0-9]+\\.[0-9]+\\.[0-9]+\\.zip"]
    }
  },
  "ci_monitors": {
    "owner/repo1": {
      "artifact_files": ["app-debug", "test-report"],
      "workflow": "build.yml",
      "branch": "main",
      "include_in_progress": false,
      "group_file_folder_name": "CI"
    },
    "owner/repo2": {
      "artifact_files": ["build-.*"],
      "group_file_folder_name": "CI"
    }
  },
  "check_interval": 300,
  "openai_api_key": "sk-your_openai_api_key_here",
  "openai_base_url": "https://api.openai.com/v1",
  "openai_model": "gpt-3.5-turbo",
  "qq_bot_url": "http://127.0.0.1:5700",
  "qq_group_id": "123456789",
  "database_path": "data.db"
}
